rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────────

    /// Verifies that the user is authenticated AND possesses the 'admin' custom claim.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ─── Collection Rules ─────────────────────────────────────────────

    // Shops collection & subcollections
    match /shops/{shopId} {
      // Students can read shop details
      allow read: if true;
      // Only verified admins (with admin custom claim) can create, edit, or delete shops
      allow write: if isAdmin();

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Menu Items subcollection
      match /menuItems/{menuItemId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // App Configuration document (force update, maintenance mode)
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny all other unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
