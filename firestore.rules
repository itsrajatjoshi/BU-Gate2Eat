rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Shops collection & subcollections ────────────────────────────
    match /shops/{shopId} {
      // Anyone can read shop details
      allow read: if true;

      // Allow writes ONLY for rajat_shop in development (Shopkeeper Panel)
      allow write: if shopId == 'rajat_shop';

      // Categories subcollection: anyone can read, rajat_shop can write
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if shopId == 'rajat_shop';
      }

      // Menu items subcollection: anyone can read, rajat_shop can write
      match /menuItems/{menuItemId} {
        allow read: if true;
        allow write: if shopId == 'rajat_shop';
      }
    }

    // App Configuration document (force update, maintenance mode)
    match /config/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny all other unlisted paths (orders, users, admin, etc.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
