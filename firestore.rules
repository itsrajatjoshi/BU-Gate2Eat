rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── AUTHENTICATION & ROLE HELPERS ─────────────────────────────────

    /// Returns true if request is from an authenticated Firebase Auth session.
    function isSignedIn() {
      return request.auth != null;
    }

    /// Returns true if caller is an authenticated customer with role == 'customer'.
    function isCustomer() {
      return isSignedIn() && request.auth.token.get('role', '') == 'customer';
    }

    /// Returns true if caller is an authenticated shopkeeper with trusted shopId claim.
    function isShopkeeper() {
      return isSignedIn()
        && request.auth.token.get('role', '') == 'shopkeeper'
        && request.auth.token.get('shopId', '') is string
        && request.auth.token.get('shopId', '').size() > 0;
    }

    /// Returns true if caller is an authenticated platform administrator.
    /// Derives authority strictly from trusted Firebase Custom Claim `role == "admin"`.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('role', '') == 'admin';
    }

    /// Administrator authorization helper.
    /// (Legacy phone 8078643910 or admin=true metadata cannot grant authorization;
    /// authority derives exclusively from trusted custom claim role == 'admin').
    function isAuthorizedAdmin() {
      return isAdmin();
    }

    // ─── VALIDATION HELPERS (Preserved for Subsequent Checkpoints) ─────

    // 1. Support Query payload validation
    function isValidSupportQuery() {
      let data = request.resource.data;
      return data.get('name', '') is string && data.get('name', '').size() > 0
        && data.get('query', '') is string && data.get('query', '').size() > 0
        && (
          (data.get('phoneNumber', '') is string && data.get('phoneNumber', '').size() >= 10) ||
          (data.get('phone', '') is string && data.get('phone', '').size() >= 10)
        )
        && data.get('status', '') == 'unread';
    }

    // 2. Order Creation Validation (Phase 4 / Order Security)
    function isValidInitialOrder() {
      let data = request.resource.data;
      return data.status == 'placed'
        && data.orderId is string && data.orderId.size() > 0
        && data.shopId is string && data.shopId.size() > 0
        && data.customerId is string && data.customerId.size() > 0
        && data.customerPhone is string && data.customerPhone.size() >= 10
        && data.totalAmount is number && data.totalAmount > 0
        && data.items is list && data.items.size() > 0;
    }

    // 3. Immutability Protection
    function areImmutableFieldsPreserved() {
      let next = request.resource.data;
      let prev = resource.data;
      return next.orderId == prev.orderId
        && next.shopId == prev.shopId
        && next.customerId == prev.customerId
        && next.totalAmount == prev.totalAmount
        && next.items == prev.items
        && (prev.get('createdAt', null) == null || next.get('createdAt', null) == prev.get('createdAt', null));
    }

    // 4. State Machine Validation
    function isValidStatusTransition() {
      let current = resource.data.status;
      let next = request.resource.data.status;
      return (current == 'placed' && (next == 'accepted' || next == 'rejected' || next == 'cancelled'))
          || (current == 'accepted' && (next == 'delivered' || next == 'rejected' || next == 'delivery_expired'))
          || (current == next);
    }

    // 5. Safe Deletion Validation
    function isAllowedOrderDeletion() {
      let status = resource.data.status;
      return status == 'placed'
          || status == 'delivered'
          || status == 'rejected'
          || status == 'delivery_expired'
          || status == 'cancelled';
    }

    // ─── 1. PUBLIC CATALOG (READ-ONLY FOR BROWSING) ────────────────────
    match /shops/{shopId} {
      allow read: if true;
      allow write: if false;

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if false;
      }

      match /menuItems/{menuItemId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ─── 2. APP CONFIGURATION ──────────────────────────────────────────
    match /config/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ─── 3. SUPPORT QUERIES COLLECTION ─────────────────────────────────
    match /supportQueries/{queryId} {
      // Submission allowed with strict validation
      allow create: if isValidSupportQuery();
      // Read allowed ONLY for verified Administrators
      allow read: if isAuthorizedAdmin();
      // Updates and deletes are permanently denied
      allow update, delete: if false;
    }

    // ─── 4. ORDERS COLLECTION (DEFAULT DENY IN 3.1) ────────────────────
    match /orders/{orderId} {
      // Explicitly denied in 3.1 baseline until Phase 4 / Phase 3.x order rules
      allow read, write: if false;
    }

    // ─── 5. SHOP STATISTICS (DEFAULT DENY IN 3.1) ──────────────────────
    match /shopStats/{shopId} {
      allow read, write: if false;

      match /monthlyStats/{monthKey} {
        allow read, write: if false;
      }
    }

    // ─── 6. DEVICE TOKENS (DEFAULT DENY IN 3.1) ────────────────────────
    match /deviceTokens/{tokenId} {
      // Cloud Functions reads/writes via Firebase Admin SDK
      allow read, write: if false;
    }

    // ─── 7. UNIVERSAL DEFAULT-DENY FALLTHROUGH ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
