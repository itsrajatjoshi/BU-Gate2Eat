rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── AUTHENTICATION & ROLE HELPERS ─────────────────────────────────

    /// Returns true if request is from an authenticated Firebase Auth session.
    function isSignedIn() {
      return request.auth != null;
    }

    /// Returns true if caller is an authenticated customer with role == 'customer'.
    function isCustomer() {
      return isSignedIn() && request.auth.token.get('role', '') == 'customer';
    }

    /// Returns true if caller is an authenticated shopkeeper with trusted shopId claim.
    function isShopkeeper() {
      return isSignedIn()
        && request.auth.token.get('role', '') == 'shopkeeper'
        && request.auth.token.get('shopId', '') is string
        && request.auth.token.get('shopId', '').size() > 0;
    }

    /// Returns true if caller is an authorized shopkeeper whose trusted shopId claim
    /// matches the target path shopId.
    function isShopOwner(shopId) {
      return isShopkeeper() && request.auth.token.get('shopId', '') == shopId;
    }

    /// Returns true if caller is an authenticated platform administrator.
    /// Derives authority strictly from trusted Firebase Custom Claim `role == "admin"`.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('role', '') == 'admin';
    }

    /// Administrator authorization helper.
    /// (Legacy phone 8078643910 or admin=true metadata cannot grant authorization;
    /// authority derives exclusively from trusted custom claim role == 'admin').
    function isAuthorizedAdmin() {
      return isAdmin();
    }

    /// Validates device token registration payload against authenticated caller session.
    /// Binds token to caller UID and strictly prevents role escalation or cross-tenant assignment.
    function isValidDeviceTokenPayload(tokenId) {
      let data = request.resource.data;
      let callerUid = request.auth.uid;
      let tokenOwner = data.get('uid', data.get('customerId', ''));
      let callerRole = request.auth.token.get('role', 'customer');
      let isCallerCustomer = callerRole == 'customer';
      let isCallerShopkeeper = callerRole == 'shopkeeper';
      let trustedShopId = request.auth.token.get('shopId', '');

      return isSignedIn()
        && data.get('token', '') == tokenId
        && tokenOwner == callerUid
        && data.get('role', '') == callerRole
        && (isCallerCustomer ? (!('shopId' in data) || data.shopId == null || data.shopId == '') : true)
        && (isCallerShopkeeper ? data.get('shopId', '') == trustedShopId : true);
    }

    // ─── VALIDATION HELPERS (Preserved for Subsequent Checkpoints) ─────

    // 1. Support Query payload validation
    function isValidSupportQuery() {
      let data = request.resource.data;
      return data.get('name', '') is string && data.get('name', '').size() > 0
        && data.get('query', '') is string && data.get('query', '').size() > 0
        && (
          (data.get('phoneNumber', '') is string && data.get('phoneNumber', '').size() >= 10) ||
          (data.get('phone', '') is string && data.get('phone', '').size() >= 10)
        )
        && data.get('status', '') == 'unread';
    }

    // 2. Order Creation Validation (Phase 4 / Order Security)
    function isValidInitialOrder() {
      let data = request.resource.data;
      return data.status == 'placed'
        && data.orderId is string && data.orderId.size() > 0
        && data.shopId is string && data.shopId.size() > 0
        && data.customerId is string && data.customerId.size() > 0
        && data.customerPhone is string && data.customerPhone.size() >= 10
        && data.totalAmount is number && data.totalAmount > 0
        && data.items is list && data.items.size() > 0;
    }

    // 3. Immutability Protection (Phase 5.3 / 5.5 — Authoritative Immutable Order Field Invariants)
    function areImmutableFieldsPreserved() {
      let next = request.resource.data;
      let prev = resource.data;
      return (prev.get('customerId', null) == null || next.get('customerId', null) == prev.get('customerId', null))
        && (prev.get('shopId', null) == null || next.get('shopId', null) == prev.get('shopId', null))
        && (prev.get('orderId', null) == null || next.get('orderId', null) == prev.get('orderId', null))
        && (prev.get('createdAt', null) == null || next.get('createdAt', null) == prev.get('createdAt', null))
        && (prev.get('totalAmount', null) == null || next.get('totalAmount', null) == prev.get('totalAmount', null))
        && (prev.get('subtotal', null) == null || next.get('subtotal', null) == prev.get('subtotal', null))
        && (prev.get('grandTotal', null) == null || next.get('grandTotal', null) == prev.get('grandTotal', null))
        && (prev.get('deliveryCharges', null) == null || next.get('deliveryCharges', null) == prev.get('deliveryCharges', null))
        && (prev.get('totalItems', null) == null || next.get('totalItems', null) == prev.get('totalItems', null))
        && (prev.get('items', null) == null || next.get('items', null) == prev.get('items', null))
        && (prev.get('shopName', null) == null || next.get('shopName', null) == prev.get('shopName', null))
        && (prev.get('customerName', null) == null || next.get('customerName', null) == prev.get('customerName', null))
        && (prev.get('customerPhone', null) == null || next.get('customerPhone', null) == prev.get('customerPhone', null))
        && (prev.get('orderMethod', null) == null || next.get('orderMethod', null) == prev.get('orderMethod', null))
        && (prev.get('specialInstructions', null) == null || next.get('specialInstructions', null) == prev.get('specialInstructions', null))
        && (prev.get('deliveryNote', null) == null || next.get('deliveryNote', null) == prev.get('deliveryNote', null))
        && (prev.get('acceptDeadline', null) == null || next.get('acceptDeadline', null) == prev.get('acceptDeadline', null))
        && (prev.get('rejectDeadline', null) == null || next.get('rejectDeadline', null) == prev.get('rejectDeadline', null))
        && (prev.get('deliveryDeadline', null) == null || next.get('deliveryDeadline', null) == prev.get('deliveryDeadline', null))
        && (prev.get('acceptedAt', null) == null || next.get('acceptedAt', null) == prev.get('acceptedAt', null))
        && (prev.get('deliveryExpiredAt', null) == null || next.get('deliveryExpiredAt', null) == prev.get('deliveryExpiredAt', null))
        && (prev.get('idempotencyKey', null) == null || next.get('idempotencyKey', null) == prev.get('idempotencyKey', null));
    }

    // 4. State Machine Validation (Phase 5.1 — Authoritative Transition Invariants)
    function isValidStatusTransition() {
      let current = resource.data.status;
      let next = request.resource.data.status;
      return next is string && (
        (current == next)
        || (current == 'placed' && (next == 'accepted' || next == 'rejected' || next == 'cancelled'))
        || (current == 'accepted' && (next == 'delivered' || next == 'rejected' || next == 'delivery_expired'))
      );
    }

    /// Authoritative State Machine Validation for Shopkeepers:
    /// Shopkeepers cannot cancel orders (cancellation is customer-only or admin).
    /// Terminal statuses ('delivered', 'rejected', 'cancelled', 'delivery_expired') are strictly immutable.
    function isValidShopkeeperTransition() {
      let current = resource.data.status;
      let next = request.resource.data.status;
      return next is string && (
        (current == next)
        || (current == 'placed' && (next == 'accepted' || next == 'rejected'))
        || (current == 'accepted' && (next == 'delivered' || next == 'rejected' || next == 'delivery_expired'))
      );
    }

    /// Authoritative State Machine Validation for Platform Administrators:
    /// Validates allowed status transitions under administrative control.
    /// Terminal statuses ('delivered', 'rejected', 'cancelled', 'delivery_expired') are strictly immutable.
    function isValidAdminTransition() {
      let current = resource.data.status;
      let next = request.resource.data.status;
      return next is string && (
        (current == next)
        || (current == 'placed' && (next == 'accepted' || next == 'rejected' || next == 'cancelled'))
        || (current == 'accepted' && (next == 'delivered' || next == 'rejected' || next == 'delivery_expired'))
      );
    }

    // 5. Safe Deletion Validation
    function isAllowedOrderDeletion() {
      let status = resource.data.status;
      return status == 'placed'
          || status == 'delivered'
          || status == 'rejected'
          || status == 'delivery_expired'
          || status == 'cancelled';
    }

    // ─── 1. PUBLIC CATALOG & TENANT MANAGEMENT (PHASE 3.2 / 3.5) ──────
    match /shops/{shopId} {
      // Public catalog browsing allowed for all callers (unauthenticated and authenticated)
      allow read: if true;

      // Shop creation: Platform administrator responsibility only.
      // Shopkeepers manage already-assigned shops; they cannot bootstrap/create shops.
      // Enforces strict schema integrity on creation to prevent injection of unknown/security fields.
      allow create: if isAdmin()
        && (!('shopId' in request.resource.data) || request.resource.data.shopId == shopId)
        && (!('id' in request.resource.data) || request.resource.data['id'] == shopId)
        && request.resource.data.keys().hasOnly([
          'id', 'shopId', 'name', 'description', 'address', 'location', 'bannerUrl', 'imageUrl',
          'shopLogoImageUrl', 'contactNumber', 'phoneNumber', 'phone', 'orderNumber', 'whatsappNumber',
          'openTime', 'closeTime', 'openingHours', 'closingHours', 'isClosedOverride', 'isOpen', 'isActive',
          'sortOrder', 'searchKeywords', 'deliveryNote', 'orderMethod', 'minimumOrderAmount', 'minOrderAmount',
          'deliveryCharges', 'deliveryCharge', 'deliveryFee', 'estimatedPrepTime', 'categoryIds',
          'createdAt', 'updatedAt'
        ]);

      // Shop update: Platform administrator or assigned shopkeeper for their own shop.
      // Tenant identity and creation timestamp are strictly immutable.
      // Both Admin and Shopkeeper updates are restricted to approved operational fields.
      allow update: if (
        (!('shopId' in request.resource.data) || request.resource.data.shopId == shopId)
        && (!('shopId' in resource.data) || !('shopId' in request.resource.data) || request.resource.data.shopId == resource.data.shopId)
        && (!('id' in request.resource.data) || request.resource.data.id == shopId)
        && (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id)
        && (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && (
          (
            isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'description', 'address',
              'contactNumber', 'phoneNumber', 'orderNumber', 'whatsappNumber',
              'openTime', 'closeTime', 'isClosedOverride', 'isActive', 'sortOrder',
              'deliveryNote', 'orderMethod', 'minimumOrderAmount', 'deliveryCharges',
              'deliveryCharge', 'deliveryFee', 'searchKeywords', 'updatedAt'
            ])
          )
          ||
          (
            isShopOwner(shopId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'description', 'address',
              'contactNumber', 'phoneNumber', 'orderNumber', 'whatsappNumber',
              'openTime', 'closeTime', 'isClosedOverride', 'isActive', 'sortOrder',
              'deliveryNote', 'orderMethod', 'minimumOrderAmount', 'deliveryCharges',
              'deliveryCharge', 'deliveryFee', 'searchKeywords', 'updatedAt'
            ])
          )
        )
      );

      // Destructive shop deletion restricted exclusively to Platform Administrator.
      // Anonymous callers, customers, and shopkeepers are strictly denied.
      allow delete: if isAdmin();

      // ─── Categories Subcollection ───────────────────────────────────
      match /categories/{categoryId} {
        // Public category read allowed
        allow read: if true;

        // Creation allowed for assigned shopkeeper or platform administrator.
        // shopId is strictly mandatory and must match the path tenant shopId.
        // Schema keys restricted to supported category schema preventing arbitrary/security fields.
        // Image pointer must be empty or fixed default neutral image; custom storage assets mediated by backend.
        allow create: if (isAdmin() || isShopOwner(shopId))
          && ('shopId' in request.resource.data)
          && request.resource.data.shopId == shopId
          && (!('id' in request.resource.data) || request.resource.data.id == categoryId)
          && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl == '' || request.resource.data.imageUrl == null || request.resource.data.imageUrl == 'https://images.unsplash.com/photo-1498837167922-ddd27525d352?w=500')
          && request.resource.data.keys().hasOnly([
            'id', 'name', 'categoryName', 'sortOrder', 'displayOrder', 'imageUrl', 'isActive',
            'shopId', 'createdAt', 'updatedAt'
          ]);

        // Updates allowed for assigned shopkeeper or platform administrator.
        // Both existing resource and update payload must have matching valid shopId.
        // shopId and categoryId are strictly immutable.
        // imageUrl is excluded from client update: mutations mediated authoritatively by backend lifecycle engine.
        allow update: if (isAdmin() || isShopOwner(shopId))
          && ('shopId' in resource.data)
          && resource.data.shopId == shopId
          && ('shopId' in request.resource.data)
          && request.resource.data.shopId == shopId
          && request.resource.data.shopId == resource.data.shopId
          && (!('id' in request.resource.data) || request.resource.data.id == categoryId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'categoryName', 'sortOrder', 'displayOrder', 'isActive', 'updatedAt'
          ]);

        // Deletion allowed for assigned shopkeeper or platform administrator.
        allow delete: if isAdmin() || isShopOwner(shopId);
      }

      // ─── Menu Items Subcollection ───────────────────────────────────
      match /menuItems/{menuItemId} {
        // Public menu item read allowed
        allow read: if true;

        // Creation allowed for assigned shopkeeper or platform administrator.
        // shopId is strictly mandatory and must match the path tenant shopId.
        // Catalog price and details are client-provided; arbitrary/security fields are prohibited.
        // Direct creation with non-empty imageUrl is prohibited; storage pointers set via backend lifecycle engine.
        allow create: if (isAdmin() || isShopOwner(shopId))
          && ('shopId' in request.resource.data)
          && request.resource.data.shopId == shopId
          && (!('id' in request.resource.data) || request.resource.data.id == menuItemId)
          && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl == '' || request.resource.data.imageUrl == null)
          && request.resource.data.keys().hasOnly([
            'id', 'shopId', 'name', 'details', 'description', 'price', 'imageUrl', 'categoryId',
            'isVeg', 'isAvailable', 'isRecommended', 'sortOrder', 'optionGroups', 'createdAt', 'updatedAt'
          ]);

        // Updates allowed for assigned shopkeeper or platform administrator.
        // shopId is strictly immutable and cannot be transferred to another shop.
        // Catalog price and availability are client-editable; imageUrl is protected against direct client reactivation.
        allow update: if (isAdmin() || isShopOwner(shopId))
          && ('shopId' in resource.data)
          && resource.data.shopId == shopId
          && ('shopId' in request.resource.data)
          && request.resource.data.shopId == shopId
          && request.resource.data.shopId == resource.data.shopId
          && (!('id' in request.resource.data) || request.resource.data.id == menuItemId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'details', 'description', 'price', 'categoryId',
            'isVeg', 'isAvailable', 'isRecommended', 'sortOrder', 'optionGroups', 'updatedAt'
          ]);

        // Deletion allowed for assigned shopkeeper or platform administrator.
        allow delete: if isAdmin() || isShopOwner(shopId);
      }

      // ─── Deletion Intents & Asset Lifecycle Subcollection ───────────
      // Managed strictly by trusted server-side Cloud Functions Admin SDK.
      // Direct client reads and mutations are completely blocked across all client roles.
      match /deletionIntents/{intentId} {
        allow read, write: if false;
      }
    }

    // ─── 2. APP CONFIGURATION ──────────────────────────────────────────
    match /config/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ─── 3. SUPPORT QUERIES COLLECTION (PHASE 3.4 / 3.5) ───────────────
    match /supportQueries/{queryId} {
      // Read allowed for customer who owns the query
      allow read: if isSignedIn() && resource.data.get('customerId', '') == request.auth.uid;
      // Read allowed for verified Platform Administrator
      allow read: if isAuthorizedAdmin();

      // Submission allowed strictly for authenticated customers binding customerId to auth UID.
      // Anonymous submission and claiming another user's customerId are strictly denied.
      // Payload keys restricted to valid customer support query schema.
      allow create: if isValidSupportQuery()
        && (
          (isCustomer() && request.resource.data.customerId == request.auth.uid) ||
          isAdmin()
        )
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'query', 'phoneNumber', 'phone', 'customerId', 'status', 'createdAt'
        ]);

      // Updates and deletes are permanently denied across all client roles.
      // Support inquiries represent permanent customer audit records.
      allow update, delete: if false;
    }

    // ─── 4. ORDERS COLLECTION (PHASE 3.3 / 3.5) ────────────────────────
    match /orders/{orderId} {
      // ── READ POLICY ──
      // Customer: can read ONLY their own orders (resource.data.customerId == request.auth.uid)
      // Shopkeeper: can read ONLY orders belonging to their assigned shop (isShopOwner)
      // Admin: platform-wide read authorization (isAdmin)
      // Anonymous: strictly denied
      allow read: if (isSignedIn() && resource.data.customerId == request.auth.uid)
        || isShopOwner(resource.data.shopId)
        || isAdmin();

      // ── CREATE POLICY ──
      // Direct client order creation is strictly DENIED across ALL client roles (Anonymous, Customer, Shopkeeper, Admin).
      // All order creation must occur exclusively via the server-authoritative Cloud Function / trusted backend.
      // Firebase Admin SDK bypasses security rules by design to write verified authoritative order documents.
      allow create: if false;

      // ── UPDATE POLICY ──
      // Invariant across ALL roles (Customer, Shopkeeper, Admin):
      // Ownership, creation metadata, and historical financial fields are strictly immutable:
      //   - customerId cannot be reassigned
      //   - shopId cannot be reassigned
      //   - orderId cannot be reassigned
      //   - createdAt cannot be altered
      //   - totalAmount, grandTotal, subtotal, deliveryCharges cannot be modified
      //   - items array and nested item pricing/subtotals cannot be modified
      //   - historical snapshots (shopName, customerName, customerPhone, deliveryNote, etc.) cannot be modified
      // Direct client updates are restricted strictly to whitelisted operational fields per role.
      allow update: if (
        areImmutableFieldsPreserved()
        && request.resource.data.get('customerId', null) == resource.data.get('customerId', null)
        && request.resource.data.get('shopId', null) == resource.data.get('shopId', null)
        && (
          // 1. Customer cancellation path:
          //    - Customer owns the order
          //    - Order is currently 'placed'
          //    - Next status is 'cancelled'
          //    - Cannot modify financial, item, or shopkeeper fields
          (
            isCustomer()
            && resource.data.customerId == request.auth.uid
            && resource.data.status == 'placed'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt'])
          )
          ||
          // 2. Shopkeeper fulfillment / status updates:
          //    - Shopkeeper owns the tenant (isShopOwner)
          //    - Authoritative state machine validation enforced (isValidShopkeeperTransition)
          //    - Restricted strictly to genuine shopkeeper fulfillment fields:
          //      status, rejectionReason, deliveryPersonId, deliveryPersonName, updatedAt
          //    - Server/lifecycle timestamps and deadlines are strictly excluded:
          //      acceptDeadline, rejectDeadline, deliveryDeadline,
          //      acceptedAt, rejectedAt, deliveredAt, cancelledAt
          //    - Financial, item, and customer identity fields are strictly immutable
          (
            isShopOwner(resource.data.shopId)
            && isValidShopkeeperTransition()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'rejectionReason', 'deliveryPersonId', 'deliveryPersonName', 'updatedAt'
            ])
          )
          ||
          // 3. Platform Admin updates:
          //    - Admin client access is NOT unrestricted:
          //      cannot mutate ownership, items, financials, or server lifecycle timestamps
          //    - Authoritative state machine validation enforced (isValidAdminTransition)
          //    - Restricted strictly to administrative fulfillment/operational fields:
          (
            isAdmin()
            && isValidAdminTransition()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'rejectionReason', 'deliveryPersonId', 'deliveryPersonName',
              'adminNote', 'adminNotes', 'cancelledAt', 'updatedAt'
            ])
          )
        )
      );

      // ── DELETE POLICY ──
      // Direct client deletion is permanently DENIED to all roles (Anonymous, Customer, Shopkeeper, Admin).
      // Orders represent immutable financial and legal audit history.
      allow delete: if false;
    }

    // ─── 5. SHOP STATISTICS (SERVER-OWNED DATA) ────────────────────────
    match /shopStats/{shopId} {
      // Client read: assigned shopkeeper can read own shop stats, admin platform-wide
      allow read: if isShopOwner(shopId) || isAdmin();

      // Client writes (create, update, delete): strictly DENIED
      // All stats mutations must occur through trusted backend / Admin SDK
      allow write: if false;

      // Subcollection for monthly stats breakdown
      match /monthlyStats/{monthKey} {
        allow read: if isShopOwner(shopId) || isAdmin();
        allow write: if false;
      }
    }

    // ─── 6. DEVICE TOKENS (PHASE 3.4 / 3.5) ────────────────────────────
    match /deviceTokens/{tokenId} {
      // Read allowed only for token owner or platform admin.
      // Blanket enumeration by non-admin is strictly denied.
      allow read: if (isSignedIn() && resource.data.get('uid', resource.data.get('customerId', '')) == request.auth.uid)
        || isAdmin();

      // Create allowed only for authenticated user registering their own token
      // with verified role and tenant bounds.
      allow create: if isValidDeviceTokenPayload(tokenId);

      // Update allowed only for the token owner preserving ownership & identity bounds.
      // token, uid, role, shopId, customerId, and phone are strictly immutable on update.
      // Only operational fields (platform, updatedAt) may be modified.
      allow update: if isValidDeviceTokenPayload(tokenId)
        && resource.data.get('uid', resource.data.get('customerId', '')) == request.auth.uid
        && request.resource.data.token == resource.data.token
        && request.resource.data.get('uid', '') == resource.data.get('uid', '')
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && (!('shopId' in resource.data) || request.resource.data.get('shopId', '') == resource.data.get('shopId', ''))
        && (!('customerId' in resource.data) || request.resource.data.get('customerId', '') == resource.data.get('customerId', ''))
        && (!('phone' in resource.data) || request.resource.data.get('phone', '') == resource.data.get('phone', ''))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'platform', 'updatedAt'
        ]);

      // Delete allowed only for token owner or platform admin.
      allow delete: if (isSignedIn() && resource.data.get('uid', resource.data.get('customerId', '')) == request.auth.uid)
        || isAdmin();
    }

    // ─── 7. USER & PROFILE DOCUMENTS (PHASE 3.4 REMEDIATION) ───────────
    match /users/{userId} {
      // User can read their own profile document; Admin can inspect platform users.
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      // Creation allowed only for user's own document with approved client fields only.
      // Server-owned fields (uid, phone, role, shopId, status) cannot be client-created.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'displayName', 'photoUrl', 'avatar', 'email', 'bio', 'address', 'createdAt', 'updatedAt'
        ]);

      // Updates restricted strictly to approved client-editable profile fields.
      // Server-owned fields (uid, phone, role, shopId, status) are strictly immutable to clients.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'photoUrl', 'avatar', 'email', 'bio', 'address', 'updatedAt'
        ]);

      // Deletions permanently denied via client SDK.
      allow delete: if false;
    }

    match /profiles/{userId} {
      // User can read their own profile document; Admin can inspect platform profiles.
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      // Creation allowed only for user's own document with approved client fields only.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'displayName', 'photoUrl', 'avatar', 'email', 'bio', 'address', 'createdAt', 'updatedAt'
        ]);

      // Updates restricted strictly to approved client-editable profile fields.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'photoUrl', 'avatar', 'email', 'bio', 'address', 'updatedAt'
        ]);

      // Deletions permanently denied via client SDK.
      allow delete: if false;
    }

    // ─── 8. SERVER-ONLY COLLECTIONS (PHASE 3.4 & PHASE 4.4) ───────────
    // Internal server collections inaccessible from any client SDK (Admin SDK / Functions only).
    match /_authChallenges/{doc=**} {
      allow read, write: if false;
    }
    match /auditLogs/{doc=**} {
      allow read, write: if false;
    }
    match /internal_metrics/{doc=**} {
      allow read, write: if false;
    }
    match /adminSettings/{doc=**} {
      allow read, write: if false;
    }
    match /idempotency/{doc=**} {
      allow read, write: if false;
    }
    match /_rateLimits/{doc=**} {
      allow read, write: if false;
    }

    // ─── 9. UNIVERSAL DEFAULT-DENY FALLTHROUGH ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
