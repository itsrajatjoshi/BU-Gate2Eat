rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Shops collection & subcollections ────────────────────────────
    match /shops/{shopId} {
      // Anyone can read shop details
      allow read: if true;

      // Allow writes for shops in development (Admin & Shopkeeper Panels)
      // Note: Temporary development permission. Will be hardened with Firebase Auth in a future phase.
      allow create, update, delete: if true;

      // Categories subcollection: anyone can read, authorized write
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if true;
      }

      // Menu items subcollection: anyone can read, authorized write
      match /menuItems/{menuItemId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // App Configuration document (force update, maintenance mode)
    match /config/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny all other unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
